# ============================================================
# Email delivery — used by BOTH the contact form and the
# appointment form. The app tries these transports in order:
#   1. Gmail SMTP   (GMAIL_USER + GMAIL_APP_PASSWORD)
#   2. Resend       (RESEND_API_KEY)
#   3. Console log  (no config — submissions are logged, dev only)
# ============================================================

# ---- Option 1: Gmail SMTP (recommended — mail sent from your Gmail) ----
# Requires 2-Step Verification enabled, then an App Password:
# https://myaccount.google.com/apppasswords
GMAIL_USER=cabinet.marien@gmail.com
GMAIL_APP_PASSWORD=

# ---- Option 2: Resend (fallback if Gmail not set) ----
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Cabinet Marien <onboarding@resend.dev>

# ---- Where messages are delivered ----
# Appointment requests + contact messages land here.
# Defaults to GMAIL_USER if unset.
APPOINTMENT_TO_EMAIL=cabinet.marien@gmail.com
CONTACT_TO_EMAIL=cabinet.marien@gmail.com

# ---- Appointment booking (Calendly) ----
# Your public Calendly scheduling link. The nav + booking CTAs open this in a popup.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/seance

# ---- Contact form delivery (Resend) ----
# Create a key at https://resend.com/api-keys. Without it, submissions are
# validated and logged server-side (the form still works in dev).
RESEND_API_KEY=

# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=contact@cabinet-marien.be

# Verified sender. Until you verify a domain in Resend, use onboarding@resend.dev.
CONTACT_FROM_EMAIL=Cabinet Marien <onboarding@resend.dev>
